# Paths (host / local runs). In Docker, compose overrides DATA_DIR and OUTPUT_DIR.
DATA_DIR=./assessment_package/ModernEdge_AI_Solutions_Engineer_Assessment/data
OUTPUT_DIR=./output

# Client systems (mock_systems compose publishes these on the host)
PAYROLL_URL=http://localhost:8081
DISPATCH_URL=http://localhost:8082
FINANCE_URL=http://localhost:8083

# Database (compose uses Postgres; local without Docker can use SQLite)
DATABASE_URL=postgresql+psycopg://modernedge:modernedge@localhost:5432/modernedge
# DATABASE_URL=sqlite:///./modernedge.db

# Model provider (OpenAI preferred when both are set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Payroll write behaviour (keep true until submissions are verified)
PAYROLL_DRY_RUN=true
PAYROLL_API_KEY=assess-7f3c9a

# Dispatch OAuth client credentials
DISPATCH_CLIENT_ID=me-assess
DISPATCH_CLIENT_SECRET=d1sp4tch-s3cret

# Finance Basic auth
FINANCE_USER=svc_assess
FINANCE_PASSWORD=Q4-close!

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_RUN_PIPELINE=false
LOG_LEVEL=INFO
